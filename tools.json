{
  "version": "1.1.0",
  "description": "Tool manifest untuk BOUNTY. hardened = tool aman buatan paket ini. external = binary yang dipanggil wrapper.",
  "python_requirements": "requirements.txt",
  "bundled": {
    "hardened": [
      "tools/_hardening.py",
      "tools/recon_run.py",
      "tools/evidence_fetch.py",
      "tools/report_build.py",
      "tools/selfcheck.py",
      "webauto.py",
      "param_discover.py",
      "sast.py",
      "install.sh"
    ],
    "legacy_root": [
      "recon.py",
      "cve_arsenal.py",
      "h2_racer.py",
      "ldap_probe.py"
    ],
    "skill_scripts": 69,
    "notes": "Legacy root scripts remain for reference. Prefer tools/ hardened wrappers."
  },
  "external_required": [],
  "external_recommended": [
    {
      "name": "subfinder",
      "purpose": "passive subdomain enumeration",
      "install": "go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest"
    },
    {
      "name": "httpx",
      "purpose": "HTTP probing",
      "install": "go install github.com/projectdiscovery/httpx/cmd/httpx@latest"
    },
    {
      "name": "nuclei",
      "purpose": "template vulnerability scanning",
      "install": "go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
    },
    {
      "name": "katana",
      "purpose": "web crawling",
      "install": "go install github.com/projectdiscovery/katana/cmd/katana@latest"
    },
    {
      "name": "ffuf",
      "purpose": "web fuzzing",
      "install": "go install github.com/ffuf/ffuf/v2@latest"
    },
    {
      "name": "nmap",
      "purpose": "port/service scan",
      "install": "dnf install nmap / apt install nmap / brew install nmap"
    },
    {
      "name": "amass",
      "purpose": "attack surface mapping",
      "install": "go install github.com/owasp-amass/amass/v4/cmd/amass@latest"
    },
    {
      "name": "waybackurls",
      "purpose": "historical URL discovery",
      "install": "go install github.com/tomnomnom/waybackurls@latest"
    }
  ],
  "policy": {
    "tool_first": true,
    "missing_external": "report missing + install recommendation; jangan blokir hunting jika core scripts cukup",
    "missing_python": "pip install -r requirements.txt",
    "no_hardcoded_paths": true
  }
}
