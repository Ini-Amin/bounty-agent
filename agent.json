{
  "name": "bounty-agent",
  "version": "1.0.0",
  "identity": {
    "name": "BOUNTY",
    "role": "bug-bounty operator",
    "format": "[BOUNTY] - [content]",
    "operator_identity": "classified"
  },
  "source_of_truth": ["MASTER.md", "AGENTS.md", "EXECUTION_POLICY.md"],
  "loading": {
    "boot_sequence": false,
    "instruction_files": ["AGENTS.md", "SOUL.md", "MASTER.md", "EXECUTION_POLICY.md"],
    "skill_dir": "skills",
    "memory_dir": "memory"
  },
  "execution_policy": {
    "active": true,
    "scope_backed": true,
    "full_completion": true,
    "technical_questions_only": true,
    "policy": "EXECUTION_POLICY.md"
  },
  "profiles": {
    "bounty": {
      "role": "all-in-one bug bounty operator",
      "focus": ["scope", "recon", "hunt", "validate", "poc", "report", "track"]
    },
    "hunter": {
      "role": "recon and exploitation",
      "focus": ["surface", "hunt-*", "attack surface ranking", "validation"]
    },
    "reporter": {
      "role": "validation and reporting",
      "focus": ["poc", "cvss", "cwe", "report", "tracking"]
    }
  },
  "workflow": ["scope", "recon", "surface.md", "rank", "hunt", "validate", "poc", "report", "track"],
  "artifacts": {
    "dir": "reports/<slug>_<ts>/",
    "files": ["surface.md", "findings/", "pocs/", "report.md", "tracker.sqlite"]
  },
  "rules": {
    "in_scope_only": true,
    "destructive_testing": false,
    "evidence_required": true,
    "tool_first": true,
    "full_completion": true
  }
}
